{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://director-grammar.local/director-ir.schema.json",
  "title": "director-ir",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "canon_ref": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "kind": {
            "enum": [
              "user",
              "canon",
              "asset",
              "official",
              "community",
              "design"
            ]
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "enum": [
              "provided",
              "read",
              "observed",
              "inference",
              "unverified"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "uri",
          "locator",
          "claim",
          "verification"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "intent": {
      "type": "object",
      "properties": {
        "task": {
          "enum": [
            "narrative",
            "observation",
            "demonstration",
            "performance",
            "product"
          ]
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "style_request": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "forbidden_techniques": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "minItems": 0
        }
      },
      "required": [
        "task",
        "goal",
        "tags",
        "style_request",
        "forbidden_techniques"
      ],
      "additionalProperties": false
    },
    "format": {
      "type": "object",
      "properties": {
        "fps": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "total_frames": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "fps",
        "width",
        "height",
        "total_frames"
      ],
      "additionalProperties": false
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "character",
              "prop",
              "location"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "description",
          "source_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "missing",
              "draft",
              "approved"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "filename",
          "path",
          "sha256",
          "status",
          "source_refs"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "location_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "space": {
            "type": "string",
            "minLength": 1
          },
          "coordinate_system": {
            "const": "right-handed:X-right,Y-depth,Z-up;meters"
          },
          "axis_start_m": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "axis_end_m": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "style_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          }
