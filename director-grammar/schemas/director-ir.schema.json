        "required": [
          "id",
          "location_id",
          "space",
          "coordinate_system",
          "axis_start_m",
          "axis_end_m",
          "style_id"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "beats": {
      "type": "array",
