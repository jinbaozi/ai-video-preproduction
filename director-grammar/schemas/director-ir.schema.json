                "start_frame": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_frame": {
                  "type": "integer",
                  "minimum": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "reaction": {
                  "type": "string",
                  "minLength": 1
