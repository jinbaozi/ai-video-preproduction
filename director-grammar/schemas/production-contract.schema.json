{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://director-grammar.local/production-contract.schema.json",
  "title": "production-contract",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "hard",
              "soft"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "minItems": 1
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^/"
            },
            "minItems": 1
          },
          "check_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "minItems": 1
          },
          "change_policy": {
            "enum": [
              "preserve",
              "explicit_revision"
            ]
          },
          "allowed_channels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "native",
                "lexical",
                "natural_language",
                "reference",
                "post",
                "review"
              ]
            }
          }
        },
        "required": [
          "id",
          "requirement",
          "priority",
          "source_refs",
          "paths",
          "check_ids",
          "change_policy",
          "allowed_channels"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "gate": {
            "enum": [
              "G0",
              "G1",
              "G2",
              "G3",
              "G4"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "static",
              "frame_review",
              "playback",
              "probe",
              "human_comprehension"
            ]
          },
          "predicate": {
            "type": "string",
            "minLength": 1
          },
          "evidence_required": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "gate",
          "scope",
          "method",
          "predicate",
          "evidence_required",
          "owner",
          "blocking"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "execution": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "plan_only",
            "authorized_execution"
          ]
        },
        "authorization_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "max_attempts_per_job": {
          "type": "integer",
          "minimum": 1
        },
        "budget_amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "mode",
        "authorization_ref",
        "max_attempts_per_job",
        "budget_amount",
        "currency",
        "stop_conditions"
      ],
      "additionalProperties": false
    },
    "acceptance": {
      "type": "object",
      "properties": {
        "rule": {
          "const": "all_blocking_checks_pass"
        },
        "waivers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "check_id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "authorization_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "check_id",
              "reason",
              "authorization_ref"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "rule",
        "waivers"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "version",
    "scope",
    "deliverables",
    "clauses",
    "checks",
    "execution",
    "acceptance"
  ],
  "additionalProperties": false
}
