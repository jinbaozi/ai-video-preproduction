{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "control-artifacts/0.1"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "enum": [
              "image",
              "video",
              "audio"
            ]
          },
          "role": {
            "enum": [
              "review",
              "clean_keyframe",
              "identity",
              "appearance",
              "style",
              "clay",
              "performance",
              "audio"
            ]
          },
          "review": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "reviewer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "result": {
                    "enum": [
                      "PASS",
                      "FAIL"
                    ]
                  },
                  "checks": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "sha256",
                  "reviewer",
                  "result",
                  "checks"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "binding": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "receipt": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "sha256",
                  "url",
                  "receipt"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "path",
          "sha256",
          "source_sha256",
          "kind",
          "role",
          "review",
          "binding"
        ]
      },
      "minItems": 0
    },
    "submitted": {
      "const": false
    }
  },
  "required": [
    "schema",
    "artifacts",
    "submitted"
  ]
}
