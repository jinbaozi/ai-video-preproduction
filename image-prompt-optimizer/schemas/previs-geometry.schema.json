{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "previs-geometry/0.1"
    },
    "basis": {
      "const": "authored_proxy"
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "resolution": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 8,
        "maximum": 4096
      },
      "minItems": 2,
      "maxItems": 2
    },
    "objects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "shot_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              },
              "shape": {
                "enum": [
                  "box",
                  "ellipsoid"
                ]
              },
              "dimensions": {
                "type": "array",
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "minItems": 3,
                "maxItems": 3
              },
              "offset_world": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "orientation": {
                "enum": [
                  "world_axes",
                  "node_direction"
                ]
              }
            },
            "required": [
              "id",
              "shot_ids",
              "node_id",
              "evidence",
              "shape",
              "dimensions",
              "offset_world",
              "orientation"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "shot_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              },
              "shape": {
                "const": "bone"
              },
              "end_node_id": {
                "type": "string",
                "minLength": 1
              },
              "radius": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "id",
              "shot_ids",
              "node_id",
              "evidence",
              "shape",
              "end_node_id",
              "radius"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "basis",
    "evidence",
    "fps",
    "resolution",
    "objects"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
