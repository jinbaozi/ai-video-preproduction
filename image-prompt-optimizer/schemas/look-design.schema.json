{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "look-design/0.1"
    },
    "owner": {
      "const": "production-design-grammar"
    },
    "material_palette": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "shot_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_pointers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "color_srgb": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "basis": {
            "const": "authored_proxy"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "entity_id",
          "shot_ids",
          "source_pointers",
          "color_srgb",
          "basis",
          "evidence"
        ]
      }
    },
    "grading_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "source_pointers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "exposure_stops": {
            "type": "number",
            "minimum": -4,
            "maximum": 4
          },
          "contrast": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "saturation": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          }
        },
        "required": [
          "shot_id",
          "source_pointers",
          "evidence",
          "exposure_stops",
          "contrast",
          "saturation"
        ]
      }
    }
  },
  "required": [
    "schema",
    "owner",
    "material_palette",
    "grading_plan"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
