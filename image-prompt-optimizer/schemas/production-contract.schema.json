        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_system": {
          "enum": [
            "screen",
            "world",
            "subject"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_owner": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
