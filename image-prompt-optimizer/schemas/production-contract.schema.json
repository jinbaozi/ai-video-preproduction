{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:image-prompt-optimizer:production-contract:1.0",
  "title": "Image Prompt Production Contract 1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "versions": {
      "type": "object",
      "properties": {
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "compiler": {
          "type": "string",
          "minLength": 1
        },
        "packs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "skill",
        "compiler",
        "packs"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "icir": {
      "type": "object",
      "properties": {
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "text_to_image",
            "reference_to_image",
            "edit",
            "inpaint",
            "composite",
            "sequence"
          ]
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          },
          "minItems": 1
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "minItems": 0
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame"
          },
          "minItems": 1
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          },
          "minItems": 0
        },
        "texts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 0
        },
        "output": {
          "type": "object",
          "properties": {
            "aspect_ratio": {
              "type": "string",
              "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
            },
            "requested_pixels": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "width": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "width",
                    "height"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "delivered_pixels": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "width": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "width",
                    "height"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            },
            "native_resolution": {
              "enum": [
                "unknown",
                "verified",
                "derivative"
              ]
            },
            "crop_safe_area": {
              "type": "string",
              "minLength": 1
            },
            "format": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "aspect_ratio",
            "requested_pixels",
            "delivered_pixels",
            "native_resolution",
            "crop_safe_area",
            "format"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "locale",
        "intent",
        "mode",
        "entities",
        "references",
        "frames",
        "relations",
        "texts",
        "output"
      ],
      "additionalProperties": false
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      },
      "minItems": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      },
      "minItems": 1
    },
    "compilations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/compilation"
      },
      "minItems": 1
    },
    "execution": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "minItems": 1
    },
    "acceptance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      },
      "minItems": 1
    },
    "unresolved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "contract_id",
    "versions",
    "sources",
    "icir",
    "facts",
    "constraints",
    "compilations",
    "execution",
    "acceptance",
    "unresolved"
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "user",
            "document",
            "reference",
            "official",
            "assumption"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewed": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "locator",
        "excerpt",
        "sha256",
        "reviewed"
      ],
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "properties": {
