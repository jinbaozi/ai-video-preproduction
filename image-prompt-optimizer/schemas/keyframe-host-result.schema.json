{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "properties": {
    "schema": {"const": "keyframe-host-result/0.1"},
    "stage_sha256": {"$ref": "#/$defs/hash"},
    "prompt_sha256": {"$ref": "#/$defs/hash"},
    "input_sha256": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hash"}},
    "output_filename": {"type": "string", "minLength": 1},
    "output_sha256": {"$ref": "#/$defs/hash"},
    "host": {"type": "string", "minLength": 1},
    "model": {"type": ["string", "null"], "minLength": 1},
    "execution_id": {"type": ["string", "null"], "minLength": 1},
    "evidence": {"type": "string", "minLength": 1},
    "recording_mode": {"enum": ["contemporaneous", "retrospective", "synthetic_test"]}
  },
  "required": ["schema", "stage_sha256", "prompt_sha256", "input_sha256", "output_filename", "output_sha256", "host", "model", "execution_id", "evidence", "recording_mode"],
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
