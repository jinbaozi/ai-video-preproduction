  "invariants": [
    "Never mutate frozen AVIR or overwrite Canon, dialogue, model, duration, creative locks or audio routes.",
    "Capability registry, actual endpoint and asset bindings override community templates.",
    "Template selection and evidence binding are not media quality approval."
  ],
  "methods": [
    {
      "id": "state-handoff",
      "roles": [
        "screenplay",
        "director",
        "art",
        "storyboard",
        "image-prompt",
        "avir",
        "compile-review"
      ],
      "instruction": "固定项与变化项分离，结尾状态成为下一镜头的入口；不改变锁定事实或信息顺序。",
      "check": "核对身份、服饰、道具、位置、时间和信息状态的承接。",
      "native_fields": [
        "/entities",
        "/shots/*/start_state",
        "/shots/*/end_state"
      ],
      "source": {
        "path": "docs/templates/en/timeline-shot-script.md",
        "sha256": "5b3fb24117f20a05b1a3995aaeeb437efb382d19720ae66242e44697e207ff2d"
      }
    },
    {
      "id": "reference-boundaries",
      "roles": [
        "art",
        "storyboard",
        "image-prompt",
        "avir",
        "compile-review"
      ],
      "instruction": "绑定真实素材的主体/场景与职责，明确继承与禁止继承；没有输入素材不发明文件或平台标记。",
      "check": "复核素材ID/文件/哈希、镜头范围和互斥参考维度。",
      "native_fields": [
        "/assets",
        "/bindings"
      ],
      "source": {
        "path": "docs/templates/en/character-reference-lock.md",
        "sha256": "48eba087ebe097d089df6d8b3634d1457500b6e8be5837917af4483e843709c8"
      }
    },
    {
      "id": "causal-beats",
      "roles": [
        "screenplay",
        "director",
        "storyboard",
        "avir",
        "compile-review"
      ],
      "instruction": "可见刺激、准备、动作、接触或变化、反应与末态构成因果；每节拍一个重点，不抹掉并行动作细节。",
      "check": "检查触发早于反应、动作所需部位可见、时长足够；无接触也不能捏造接触。",
      "native_fields": [
        "/shots/*/purpose",
        "/timeline/actions",
        "/timeline/performances"
      ],
      "source": {
        "path": "docs/templates/en/dialogue-performance-beats.md",
        "sha256": "dd779d73211ec3d5665c7e6310f03f8089d5bddddf415467a09ca936f1cc326b"
      }
    },
    {
      "id": "camera-body-separation",
      "roles": [
        "director",
        "storyboard",
        "avir",
        "compile-review"
      ],
      "instruction": "摄影机位置/朝向/路径与身体朝向、视线、持物分开；世界左右、画面左右和自身左右不混用。",
      "check": "对照安装位置、视点、路径和切点，检查摄影机没有凭空瞬移。",
      "native_fields": [
        "/shots/*/camera",
        "/timeline/camera_operations",
        "/timeline/motion_tracks"
      ],
      "source": {
        "path": "docs/templates/en/pov-continuous-take.md",
        "sha256": "8204f99dd81bd26ca6b28f3ae3aff5a44883a39020711266e3ca86cd7b09242c"
      }
    },
    {
      "id": "sound-ownership",
      "roles": [
        "screenplay",
        "director",
        "storyboard",
        "avir",
        "compile-review"
      ],
      "instruction": "台词原文、说话人、声源、语言、时间和原生/后期通道保持独立；内心活动不能自动变成旁白。",
      "check": "按冻结音轨核对可听内容和动作，未提供音轨不许标记同步或音色复刻通过。",
      "native_fields": [
        "/audio",
        "/timeline/audio_events"
      ],
      "source": {
        "path": "docs/templates/en/dialogue-performance-beats.md",
        "sha256": "dd779d73211ec3d5665c7e6310f03f8089d5bddddf415467a09ca936f1cc326b"
      }
    },
    {
      "id": "temporal-coverage",
      "roles": [
        "storyboard",
        "avir",
        "compile-review"
      ],
      "instruction": "镜头使用连续半开时间区间并覆盖总时长；跨生成片段重述必要上下文和参考，不自动缩短动作或台词。",
      "check": "核对零起点、相邻边界、最终时长及安全切点；数值意图不等于帧级控制保证。",
      "native_fields": [
        "/output/duration_ms",
        "/shots",
        "/timeline/segments"
      ],
      "source": {
        "path": "docs/templates/en/timeline-shot-script.md",
        "sha256": "5b3fb24117f20a05b1a3995aaeeb437efb382d19720ae66242e44697e207ff2d"
      }
    }
