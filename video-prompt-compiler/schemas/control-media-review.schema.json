{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "control-media-review/0.1"
    },
    "media_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "planned_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "at_ms": {
            "type": "integer",
            "minimum": 0
          },
          "xy": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "node_id",
          "at_ms",
          "xy"
        ]
      },
      "minItems": 0
    },
    "observed_points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "at_ms": {
            "type": "integer",
            "minimum": 0
          },
          "xy": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              {
                "type": "null"
              }
            ]
          },
          "visibility": {
            "enum": [
              "visible",
              "occluded",
              "tracking_failed"
            ]
          }
        },
        "required": [
          "node_id",
          "at_ms",
          "xy",
          "visibility"
        ]
      },
      "minItems": 0
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "planned_ms": {
            "type": "integer",
            "minimum": 0
          },
          "observed_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "planned_ms",
          "observed_ms"
        ]
      },
      "minItems": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "dimension": {
            "enum": [
              "identity",
              "appearance",
              "event",
              "camera",
              "expression",
              "color",
              "contact",
              "overlay"
            ]
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "UNDETERMINED"
            ]
          },
          "issue": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "enum": [
              "director",
              "production-design",
              "storyboard",
              "image-optimizer",
              "video-compiler",
              "external-runner"
            ]
          },
          "source_pointers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "dimension",
          "start_ms",
          "end_ms",
          "result",
          "issue",
          "owner",
          "source_pointers"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema",
    "media_sha256",
    "reviewer",
    "width",
    "height",
    "planned_points",
    "observed_points",
    "events",
    "findings"
  ]
}
