{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://production-design-grammar.local/qa-report.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "art_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "NOT_RUN",
        "IN_REVIEW",
        "ACCEPTED_RECORDED"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "reviewer": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "observation": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "kind": {
                  "enum": [
                    "image",
                    "video",
                    "report"
                  ]
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "file",
                "sha256",
                "kind",
                "locator"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "check_id",
          "result",
          "reviewer",
          "observation",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "art_sha256",
    "receipt_sha256",
    "status",
    "records"
  ],
  "additionalProperties": false
}
