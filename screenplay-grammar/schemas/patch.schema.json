{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://screenplay-grammar.local/patch.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "screenplay-patch/1.0"
    },
    "base_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "value": {},
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "value",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema",
    "base_sha256",
    "changes"
  ],
  "additionalProperties": false
}
