{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://screenplay-grammar.local/director-map.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "screenplay-director-map/1.0"
    },
    "screenplay_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "director_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "source_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "target_clause": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "target_checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^/"
                },
                "op": {
                  "enum": [
                    "equals",
                    "contains",
                    "exists"
                  ]
                },
                "value": {}
              },
              "required": [
                "path",
                "op"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "requirement_id",
          "source_fingerprint",
          "target_clause",
          "target_checks",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema",
    "screenplay_sha256",
    "director_sha256",
    "reviewer",
    "findings",
    "mappings"
  ],
  "additionalProperties": false
}
