  "scenes": [
    {
      "blocks": [
        {
          "id": "B1",
          "kind": "action",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": null,
          "text": "林照擦去灯罩水雾。焰心里，一个同样穿湿衣的自己正在吹灯。"
        },
        {
          "id": "B2",
          "kind": "dialogue",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": "LIN",
          "text": "别吹。我昨夜就是这样收工的。"
        },
        {
          "id": "B3",
          "kind": "dialogue",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": "OLD",
          "text": "水涨了。谁也不会来了。"
        },
        {
          "id": "B4",
          "kind": "action",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": null,
          "text": "远处传来一下叩船帮的声音。灯里的自己捂住耳朵，火光随之缩小。"
        }
      ],
      "heading": "外景·渡口灯亭·夜",
      "id": "S1",
      "purpose": "建立灯的异常与昨夜未留灯的事实",
      "source_refs": [
        "DESIGN"
      ]
    },
    {
      "blocks": [
        {
          "id": "B5",
          "kind": "dialogue",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": "LIN",
          "text": "你听见了。"
        },
        {
          "id": "B6",
          "kind": "dialogue",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": "OLD",
          "text": "我听见了。可我没有出去。"
        },
        {
          "id": "B7",
          "kind": "action",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": null,
          "text": "林照把手贴在灯罩上。焰中的渡口仿佛延伸到掌心，他摸到的仍是冰冷玻璃。"
        },
        {
          "id": "B8",
          "kind": "dialogue",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": "OLD",
          "text": "灯只能留住一夜。罩子一开，我就散了。你添油，我还能把那些理由再说一遍。"
        },
        {
          "id": "B9",
          "kind": "action",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": null,
          "text": "油壶只剩薄薄一层。此刻，河上又响起一下叩船帮的声音。林照把油壶停在灯门前。"
        }
      ],
      "heading": "内景·灯亭·连续",
      "id": "S2",
      "purpose": "解释规则与选择代价",
      "source_refs": [
        "DESIGN"
      ]
    },
    {
      "blocks": [
        {
          "id": "B10",
          "kind": "dialogue",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": "LIN",
          "text": "我不陪你说了。"
        },
        {
          "id": "B11",
          "kind": "action",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": null,
          "text": "林照揭开灯罩。焰中的自己没有阻拦，随一缕烟散去。他添上最后一点油，重新罩好灯，提着它沿石阶向下。"
        },
        {
          "id": "B12",
          "kind": "dialogue",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": "LIN",
          "text": "别靠左，那里缺一阶。我给你照着。"
        },
        {
          "id": "B13",
          "kind": "action",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": null,
          "text": "河上的桨声转向亮处。灯罩上映着两级湿石阶，再没有第二个人影。"
        }
      ],
      "heading": "外景·渡口·稍后",
      "id": "S3",
      "purpose": "用当下行动回应昨日选择",
      "source_refs": [
        "DESIGN"
      ]
    }
