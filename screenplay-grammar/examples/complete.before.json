        {
          "id": "K1",
          "kind": "action",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": null,
          "text": "纸箱堆在墙边。桌上摆着两只碗，一只扣着。林岚把一串钥匙放在桌上。"
        },
        {
          "id": "K2",
          "kind": "dialogue",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": "DAUGHTER",
          "text": "房东明早来收房。"
        },
        {
          "id": "K3",
          "kind": "action",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": null,
          "text": "母亲把其中一把钥匙拨到林岚面前。"
        },
        {
          "id": "K4",
          "kind": "dialogue",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": "MOTHER",
          "text": "这把留着。"
        },
        {
          "id": "K5",
          "kind": "dialogue",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": "DAUGHTER",
          "text": "门锁要换。"
        },
        {
          "id": "K6",
          "kind": "action",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": null,
          "text": "母亲拿起钥匙，挂回门边的钩子，手停在那里。"
        },
        {
          "id": "K7",
          "kind": "dialogue",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": "MOTHER",
          "text": "那你明早来，替我交。"
        },
        {
          "id": "K8",
          "kind": "action",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": null,
          "text": "林岚取下钥匙，放进外套口袋。"
        },
        {
          "id": "K9",
          "kind": "dialogue",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": "DAUGHTER",
          "text": "我带早饭。"
        }
      ],
