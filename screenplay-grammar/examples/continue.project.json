  "scenes": [
    {
      "blocks": [
        {
          "id": "K1",
          "kind": "action",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": null,
          "text": "纸箱堆在墙边。桌上摆着两只碗，一只扣着。林岚把一串钥匙放在桌上。"
        },
        {
          "id": "K2",
          "kind": "dialogue",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": "DAUGHTER",
          "text": "房东明早来收房。"
        },
        {
          "id": "K3",
          "kind": "action",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": null,
          "text": "母亲把其中一把钥匙拨到林岚面前。"
        },
        {
          "id": "K4",
          "kind": "dialogue",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": "MOTHER",
          "text": "这把留着。"
        },
        {
          "id": "K5",
          "kind": "dialogue",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": "DAUGHTER",
          "text": "门锁要换。"
        },
        {
          "id": "K6",
          "kind": "action",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": null,
          "text": "母亲拿起钥匙，挂回门边的钩子，手停在那里。"
        },
        {
          "id": "K7",
          "kind": "dialogue",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": "MOTHER",
          "text": "那你明早来，替我交。"
        },
        {
          "id": "K8",
          "kind": "action",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": null,
          "text": "林岚取下钥匙，放进外套口袋。"
        },
        {
          "id": "K9",
          "kind": "dialogue",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": "DAUGHTER",
          "text": "我带早饭。"
        },
        {
          "id": "K10",
          "kind": "action",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": null,
          "text": "母亲将扣着的碗翻过来，推到林岚面前。"
        }
      ],
      "heading": "内景·旧家厨房·夜",
      "id": "KITCHEN",
      "purpose": "从处理交房转向主动约定见面",
      "source_refs": [
        "DESIGN"
      ]
    },
    {
      "blocks": [
        {
          "id": "C1",
          "kind": "action",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": null,
          "text": "敲门声响起。母亲开门，林岚拎着两份早饭进来。她把钥匙放进交房用的纸袋。"
        },
        {
          "id": "C2",
          "kind": "dialogue",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": "MOTHER",
          "text": "以后换我去你那里？"
        },
        {
          "id": "C3",
          "kind": "dialogue",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": "DAUGHTER",
          "text": "先把早饭吃了。地址我写给你。"
        },
        {
          "id": "C4",
          "kind": "action",
          "source_refs": [
            "DESIGN"
          ],
          "speaker": null,
          "text": "母亲把两只碗并排摆好。林岚抽出一张纸，写下新住处的地址，放在母亲那只碗旁。"
        }
      ],
      "heading": "内景·旧家厨房·次日早晨",
      "id": "NEXT_MORNING",
      "purpose": "兑现早饭约定，保留搬离旧家的事实",
      "source_refs": [
        "DESIGN"
      ]
    }
