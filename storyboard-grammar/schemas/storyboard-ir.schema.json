{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyboard-grammar.local/storyboard-ir.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "storyboard-ir/1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "canon_ref": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "minItems": 1
        },
        "shot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "minItems": 0
        },
        "excluded_utterance_ids": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "reason",
              "source_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "source_ids",
        "shot_ids",
        "excluded_utterance_ids"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "upstreams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/upstream"
      },
      "minItems": 0
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      },
      "minItems": 1
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      },
      "minItems": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "minItems": 0
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      },
      "minItems": 0
    },
    "beats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/beat"
      },
      "minItems": 1
    },
    "style": {
      "$ref": "#/$defs/style"
    },
    "delivery": {
      "$ref": "#/$defs/delivery"
    },
    "shots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shot"
      },
      "minItems": 1
    },
    "audio": {
      "type": "object",
      "properties": {
        "utterances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/utterance"
          },
          "minItems": 0
        },
        "cues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cue"
          },
          "minItems": 0
        }
      },
      "required": [
        "utterances",
        "cues"
      ],
      "additionalProperties": false
    },
    "contract": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "revision",
    "canon_ref",
    "intent",
    "scope",
    "sources",
    "upstreams",
    "entities",
    "scenes",
    "assets",
    "bindings",
    "beats",
    "style",
    "delivery",
    "shots",
    "audio",
    "contract"
  ],
  "additionalProperties": false,
  "$defs": {
    "span": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "source_utterance": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "speaker_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "dialogue",
            "narration",
            "internal_voice"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      },
      "required": [
        "id",
        "speaker_id",
        "kind",
        "text",
        "span"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "user",
            "script",
            "canon",
            "director",
            "art",
            "observed",
            "design",
            "research"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "enum": [
            "provided",
            "read",
            "observed",
            "inference",
            "unverified"
          ]
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        },
        "excerpt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "file_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "utterances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_utterance"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "kind",
        "uri",
        "locator",
        "revision",
        "verification",
        "excerpt",
        "excerpt_sha256",
        "file_sha256",
        "utterances"
      ],
      "additionalProperties": false
    },
    "lock": {
      "type": "object",
      "properties": {
        "source_pointer": {
          "type": "string",
          "minLength": 1
        },
        "target_pointer": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "equal",
            "mapped"
          ]
        },
        "source_value": {},
        "target_value": {},
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_pointer",
        "target_pointer",
        "mode",
        "source_value",
        "target_value",
        "reason"
      ],
      "additionalProperties": false
    },
    "upstream": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "director",
            "art",
            "canon"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "locks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lock"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "kind",
        "uri",
        "sha256",
        "schema_version",
        "project_id",
        "revision",
        "locks"
      ],
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "person",
            "animal",
            "prop",
            "environment",
            "voice"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "appearance": {
          "type": "string",
          "minLength": 1
        },
        "identity_locks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "kind",
        "name",
        "appearance",
        "identity_locks",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "location_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "entity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "minItems": 1
        },
        "time_of_day": {
          "type": "string",
          "minLength": 1
        },
        "coordinates": {
          "type": "object",
          "properties": {
            "unit": {
              "const": "m"
            },
            "axes": {
              "const": "x=world-right,y=up,z=depth"
            },
            "origin": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "unit",
            "axes",
            "origin"
          ],
          "additionalProperties": false
        },
        "bounds": {
          "type": "object",
          "properties": {
            "min_m": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "max_m": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "min_m",
            "max_m"
          ],
          "additionalProperties": false
        },
        "axis": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "start_m": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "end_m": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "id",
            "start_m",
            "end_m"
          ],
          "additionalProperties": false
        },
        "lighting": {
          "type": "object",
          "properties": {
            "world_source": {
              "type": "string",
              "minLength": 1
            },
            "position_m": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "quality": {
              "type": "string",
              "minLength": 1
            },
            "color": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "world_source",
            "position_m",
            "quality",
            "color"
          ],
          "additionalProperties": false
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "description",
        "location_id",
        "entity_ids",
        "time_of_day",
        "coordinates",
        "bounds",
        "axis",
        "lighting",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "entity_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "metadata_only",
            "available",
            "observed"
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "entity_id",
        "filename",
        "path",
        "sha256",
        "revision",
        "status",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "entity_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "shot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "minItems": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "identity",
              "wardrobe",
              "scene",
              "composition",
              "motion",
              "camera",
              "voice",
              "music"
            ]
          },
          "minItems": 1
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "asset_id",
        "entity_id",
        "shot_ids",
        "roles",
        "exclude",
        "required"
      ],
      "additionalProperties": false
    },
    "beat": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "scene_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "change": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "minItems": 0
        },
        "required": {
          "type": "boolean"
        },
        "exclusion_reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "scene_id",
        "change",
        "depends_on",
        "required",
        "exclusion_reason",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "position_m": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "yaw_deg": {
          "type": "number"
        },
        "head_yaw_deg": {
          "type": "number"
        },
        "head_pitch_deg": {
          "type": "number"
        },
        "pose": {
          "type": "string",
          "minLength": 1
        },
        "gaze_target": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "support": {
          "type": "string",
          "minLength": 1
        },
        "contacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "holder": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "position_m",
        "yaw_deg",
        "head_yaw_deg",
        "head_pitch_deg",
        "pose",
        "gaze_target",
        "support",
        "contacts",
        "holder",
        "condition"
      ],
      "additionalProperties": false
    },
    "states": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/state"
      },
      "minProperties": 1
    },
    "change": {
      "type": "object",
      "properties": {
        "entity_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "field": {
          "enum": [
            "position_m",
            "yaw_deg",
            "head_yaw_deg",
            "head_pitch_deg",
            "pose",
            "gaze_target",
            "support",
            "contacts",
            "holder",
            "condition"
          ]
        },
        "before": {},
        "after": {}
      },
      "required": [
        "entity_id",
        "field",
        "before",
        "after"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "move",
            "pose",
            "contact",
            "release",
            "grasp",
            "state"
          ]
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "effector": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "feedback": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          },
          "minItems": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "minItems": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          }
        }
      },
      "required": [
        "id",
        "start_frame",
        "end_frame",
        "kind",
        "actor_id",
        "target_id",
        "effector",
        "trigger",
        "action",
        "feedback",
        "changes",
        "source_refs",
        "depends_on"
      ],
      "additionalProperties": false
    },
    "performance": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame": {
          "type": "integer",
          "minimum": 0
        },
        "actor_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "face": {
