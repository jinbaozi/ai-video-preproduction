      "output": "stages/01-项目设置与资料摄取/project-configuration.json",
      "artifact_type": "project-configuration"
    },
    {
      "id": "intake_normalize",
      "phase_id": "phase-02",
      "kind": "semantic",
      "role": "intake",
      "resources": [
        "references/role-intake.md",
        "references/safety-rights.md"
