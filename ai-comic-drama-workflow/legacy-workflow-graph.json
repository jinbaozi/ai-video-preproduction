      "output": "stages/03-叙事提取与动态记忆/narrative-bundle.json",
      "artifact_type": "narrative-bundle"
    },
    {
      "id": "adaptation_plan",
      "phase_id": "phase-04",
      "kind": "semantic",
      "role": "story",
      "resources": [
        "references/role-story.md"
      ],
      "inputs": [
        "stages/03-叙事提取与动态记忆/narrative-bundle.json"
