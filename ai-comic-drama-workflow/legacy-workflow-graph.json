      "output": "stages/04-改编方案/adaptation-plan.json",
      "artifact_type": "adaptation-plan"
    },
    {
      "id": "director_treatment",
      "phase_id": "phase-04",
      "kind": "semantic",
      "role": "director",
      "resources": [
        "references/role-director.md"
