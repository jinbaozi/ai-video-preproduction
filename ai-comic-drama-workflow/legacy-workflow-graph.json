      "output": "stages/02-输入标准化与缺口处理/intake-brief.json",
      "artifact_type": "intake-brief"
    },
    {
      "id": "gap_resolution",
      "phase_id": "phase-02",
      "kind": "deterministic",
      "role": "kernel",
      "required_decisions": [
