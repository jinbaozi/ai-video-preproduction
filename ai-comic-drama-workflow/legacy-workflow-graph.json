      "artifact_type": "source-registry"
    },
    {
      "id": "project_configuration",
      "phase_id": "phase-01",
      "kind": "deterministic",
      "role": "kernel",
      "required_decisions": [
        "work_depth",
        "adaptation_policy"
      ],
      "inputs": [
        "stages/01-项目设置与资料摄取/source-registry.json"
