{
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "project_id",
    "revision",
    "stage_id",
    "role_provenance",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "capability-snapshot"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "stage_id": {
      "type": "string",
      "enum": [
        "visual_capability_probe",
        "media_capability_probe"
      ]
    },
    "role_provenance": {
      "type": "string",
      "const": "kernel"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "evidence"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "available",
              "unavailable",
              "requires_account",
              "requires_payment",
              "unknown"
            ]
          },
          "evidence": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-comic-drama:3.0:capability-snapshot.schema.json"
}
