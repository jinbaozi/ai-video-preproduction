{
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "project_id",
    "revision",
    "stage_id",
    "role_provenance",
    "workflow_id",
    "phases"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "phase-index"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "stage_id": {
      "type": "string",
      "const": "project_setup"
    },
    "role_provenance": {
      "type": "string",
      "const": "kernel"
    },
    "workflow_id": {
      "type": "string",
      "const": "ai-comic-drama-main-v3"
    },
    "phases": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "required": [
          "id",
          "index",
          "name",
          "folder",
          "stage_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 13
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "folder": {
            "type": "string",
            "minLength": 1
          },
          "stage_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-comic-drama:3.0:phase-index.schema.json"
}
