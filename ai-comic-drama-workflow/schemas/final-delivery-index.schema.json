{
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "project_id",
    "revision",
    "stage_id",
    "role_provenance",
    "delivery_id",
    "status",
    "artifacts",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "final-delivery-index"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "stage_id": {
      "type": "string",
      "const": "export"
    },
    "role_provenance": {
      "type": "string",
      "const": "kernel"
    },
    "delivery_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "prompt_ready",
        "media_partial",
        "media_verified",
        "export_ready",
        "draft"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-comic-drama:3.0:final-delivery-index.schema.json"
}
