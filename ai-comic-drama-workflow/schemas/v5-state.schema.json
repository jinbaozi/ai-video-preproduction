{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v5-state",
  "type": "object",
  "required": [
    "schema_version",
    "artifacts",
    "media",
    "sources",
    "completed_tasks",
    "prompts",
    "approvals",
    "decisions",
    "active_task",
    "inflight",
    "build"
  ],
  "properties": {
    "schema_version": {
      "const": "5.0"
    },
    "artifacts": {
      "type": "object"
    },
    "media": {
      "type": "object"
    },
    "sources": {
      "type": "array"
    },
    "completed_tasks": {
      "type": "object"
    },
    "prompts": {
      "type": "object"
    },
    "approvals": {
      "type": "object"
    },
    "decisions": {
      "type": "array"
    },
    "control_policy": {
      "const": "adaptive-control/1.0"
    },
    "control_minimum": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "output_policy": {
      "const": "compact-workspace/1.0"
    },
    "creative_policy": {
      "enum": [
        "automatic",
        "ask"
      ]
    },
    "editing_backend": {
      "enum": [
        "jianying-headless",
        "ffmpeg"
      ]
    },
    "production_policy": {
      "enum": [
        "verified-production/1.0",
        "studio-production/2.0"
      ]
    },
    "flow_refinement": {
      "type": "object",
      "required": [
        "policy",
        "max_attempts"
      ],
      "properties": {
        "policy": {
          "const": "google-flow-2k/1.0"
        },
        "account_hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "additionalProperties": false
    },
    "context_policy": {
      "const": "minimal-core/1.0"
    },
    "execution_policy": {
      "const": "studio-execution/1.0"
    },
    "stop_after": {
      "enum": [
        "images",
        "full"
      ]
    }
  },
  "additionalProperties": true
}
