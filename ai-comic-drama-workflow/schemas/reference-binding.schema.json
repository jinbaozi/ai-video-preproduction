{
  "type": "object",
  "properties": {
    "reference_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "character_identity",
        "storyboard_frame",
        "layout",
        "style",
        "scene",
        "prop"
      ]
    },
    "entity_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "allowed_inheritance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_inheritance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "shot_id": {
      "type": "string",
      "minLength": 1
    },
    "time_s": {
      "type": "number",
      "minimum": 0
    },
    "slot": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "reference_id",
    "role",
    "entity_ids",
    "revision",
    "path",
    "sha256",
    "allowed_inheritance",
    "forbidden_inheritance",
    "approval_ref"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-comic-drama:3.0:reference-binding.schema.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "storyboard_frame"
          }
        }
      },
      "then": {
        "required": [
          "shot_id",
          "time_s"
        ]
      }
    }
  ]
}
