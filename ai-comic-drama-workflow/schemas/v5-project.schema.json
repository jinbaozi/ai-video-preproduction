{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v5-project",
  "type": "object",
  "required": [
    "schema_version",
    "workflow_id",
    "project_id",
    "execution_mode",
    "delivery",
    "mode",
    "max_shots_per_task"
  ],
  "properties": {
    "schema_version": {
      "const": "5.0"
    },
    "workflow_id": {
      "const": "ai-comic-drama-v5"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_mode": {
      "enum": [
        "current-agent",
        "codex-agents"
      ]
    },
    "orchestration_protocol": {
      "const": "6.0"
    },
    "delivery": {
      "enum": [
        "full",
        "text-only"
      ]
    },
    "mode": {
      "enum": [
        "text",
        "reference",
        "keyframe",
        "edit",
        "extend"
      ]
    },
    "max_shots_per_task": {
      "const": 5
    },
    "production_target": {
      "enum": [
        "none",
        "video"
      ],
      "description": "none keeps the preproduction endpoint. video adds a separate VIDEO_DELIVERED endpoint. Omitted values mean none."
    },
    "workflow_profile": {
      "const": "lean"
    },
    "control_policy": {
      "const": "adaptive-control/1.0"
    },
    "control_minimum": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "output_policy": {
      "const": "compact-workspace/1.0"
    },
    "creative_policy": {
      "enum": [
        "automatic",
        "ask"
      ]
    },
    "editing_backend": {
      "enum": [
        "jianying-headless",
        "ffmpeg"
      ]
    },
    "production_policy": {
      "const": "verified-production/1.0"
    },
    "flow_refinement": {
      "type": "object",
      "required": [
        "policy",
        "max_attempts"
      ],
      "properties": {
        "policy": {
          "const": "google-flow-2k/1.0"
        },
        "account_hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_mode": {
            "const": "codex-agents"
          }
        }
      },
      "then": {
        "required": [
          "orchestration_protocol"
        ]
      }
    },
    {
      "if": {
        "required": [
          "orchestration_protocol"
        ]
      },
      "then": {
        "properties": {
          "execution_mode": {
            "const": "codex-agents"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "workflow_profile"
        ]
      },
      "then": {
        "properties": {
          "execution_mode": {
            "const": "current-agent"
          }
        },
        "not": {
          "required": [
            "orchestration_protocol"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "output_policy"
        ]
      },
      "then": {
        "required": [
          "workflow_profile"
        ],
        "properties": {
          "workflow_profile": {
            "const": "lean"
          }
        },
        "not": {
          "required": [
            "orchestration_protocol"
          ]
        }
      }
    }
  ],
  "additionalProperties": true
}
