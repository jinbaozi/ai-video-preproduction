{
  "type": "object",
  "required": [
    "schema_version",
    "result_id",
    "project_id",
    "stage_id",
    "context_fingerprint",
    "status",
    "artifact",
    "findings",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "context_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "needs_decision",
        "failed"
      ]
    },
    "artifact": {
      "type": "object"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-comic-drama:3.0:agent-result.schema.json"
}
