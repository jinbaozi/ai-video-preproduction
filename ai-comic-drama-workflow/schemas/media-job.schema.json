{
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "project_id",
    "revision",
    "stage_id",
    "role_provenance",
    "job_id",
    "execution_context",
    "prompt",
    "prompt_sha256",
    "input_hash",
    "reference_bindings",
    "status",
    "output_kind"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "artifact_type": {
      "const": "media-job"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "role_provenance": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_context": {
      "enum": [
        "codex-host",
        "local-blender",
        "provided"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "prompt_sha256": {
      "type": "string",
      "minLength": 1
    },
    "input_hash": {
      "type": "string",
      "minLength": 1
    },
    "reference_bindings": {
      "type": "array",
      "items": {
        "$ref": "urn:ai-comic-drama:3.0:reference-binding.schema.json"
      }
    },
    "status": {
      "enum": [
        "pending",
        "returned",
        "failed",
        "uncertain"
      ]
    },
    "output_kind": {
      "enum": [
        "asset",
        "storyboard",
        "previsualization"
      ]
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-comic-drama:3.0:media-job.schema.json"
}
