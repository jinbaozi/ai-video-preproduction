{
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "project_id",
    "revision",
    "stage_id",
    "role_provenance",
    "package_id",
    "adapter_id",
    "shot_ids",
    "prompts",
    "warnings",
    "degradations",
    "delivery_scope",
    "dual_reference_status",
    "platform_readiness",
    "execution_status"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "prompt-package"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "role_provenance": {
      "type": "string",
      "minLength": 1
    },
    "package_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "shot_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "shot_id",
          "canonical_fact_hash",
          "required_asset_ids",
          "selected_reference_ids",
          "reference_bindings",
          "execution_controls",
          "field_coverage"
        ],
        "properties": {
          "shot_id": {
            "type": "string",
            "minLength": 1
          },
          "duration_s": {
            "type": "number",
            "minimum": 1,
            "maximum": 12
          },
          "canonical_fact_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "required_asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selected_reference_ids": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string"
            }
          },
          "execution_prompt": {
            "type": "string",
            "minLength": 1
          },
          "adapted_prompt": {
            "type": "string",
            "minLength": 1
          },
          "canonical_record": {
            "type": "object"
          },
          "source_trace": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "source_trace_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reference_bindings": {
            "type": "array",
            "items": {
              "$ref": "urn:ai-comic-drama:3.0:reference-binding.schema.json"
            },
            "maxItems": 5
          },
          "execution_controls": {
            "type": "object"
          },
          "field_coverage": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_pointer": {
                  "type": "string",
                  "minLength": 1
                },
                "destination_pointer": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "const": "transferred"
                }
              },
              "required": [
                "source_pointer",
                "destination_pointer",
                "sha256",
                "status"
              ]
            },
            "minItems": 1
          }
        },
        "anyOf": [
          {
            "type": "object",
            "required": [
              "execution_prompt",
              "canonical_record",
              "source_trace",
              "source_trace_hash"
            ]
          },
          {
            "type": "object",
            "required": [
              "adapted_prompt"
            ]
          }
        ],
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "degradations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "delivery_scope": {
      "enum": [
        "prompt-draft",
        "dual-reference-previs"
      ]
    },
    "dual_reference_status": {
      "enum": [
        "missing",
        "ready"
      ]
    },
    "platform_readiness": {
      "enum": [
        "unverified",
        "supported",
        "incompatible"
      ]
    },
    "execution_status": {
      "enum": [
        "not_submitted",
        "submitted",
        "returned",
        "verified"
      ]
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-comic-drama:3.0:prompt-package.schema.json"
}
