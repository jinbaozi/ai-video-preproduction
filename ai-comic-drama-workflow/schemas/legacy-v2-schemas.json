  "prompt-package.schema.json": {
    "type": "object",
    "required": [
      "schema_version",
      "artifact_type",
      "artifact_id",
      "project_id",
      "revision",
      "stage_id",
      "role_provenance",
      "package_id",
      "adapter_id",
      "shot_ids",
      "prompts",
      "warnings",
      "degradations"
    ],
    "properties": {
      "schema_version": {
        "type": "string",
        "const": "2.0"
      },
      "artifact_type": {
        "type": "string",
        "const": "prompt-package"
      },
      "artifact_id": {
        "type": "string",
        "minLength": 1
      },
      "project_id": {
        "type": "string",
        "minLength": 1
      },
      "revision": {
        "type": "integer",
        "minimum": 1
      },
      "stage_id": {
        "type": "string",
        "minLength": 1
      },
      "role_provenance": {
        "type": "string",
        "minLength": 1
      },
      "package_id": {
        "type": "string",
        "minLength": 1
      },
      "adapter_id": {
        "type": "string",
        "minLength": 1
      },
      "shot_ids": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "prompts": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "shot_id",
            "canonical_fact_hash",
            "required_asset_ids",
            "selected_reference_ids"
          ],
          "properties": {
            "shot_id": {
              "type": "string",
              "minLength": 1
            },
            "duration_s": {
              "type": "number",
              "minimum": 1,
              "maximum": 12
            },
            "canonical_fact_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "required_asset_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "selected_reference_ids": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "string"
              }
            },
            "execution_prompt": {
              "type": "string",
              "minLength": 1
            },
            "adapted_prompt": {
              "type": "string",
              "minLength": 1
            },
            "canonical_record": {
              "type": "object"
            },
            "source_trace": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "source_trace_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "anyOf": [
            {
              "type": "object",
              "required": [
                "execution_prompt",
                "canonical_record",
                "source_trace",
                "source_trace_hash"
              ]
            },
            {
              "type": "object",
              "required": [
                "adapted_prompt"
              ]
            }
          ],
          "additionalProperties": true
        }
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object"
        }
      },
      "degradations": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "additionalProperties": true
  },
