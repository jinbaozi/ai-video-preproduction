{
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "project_id",
    "revision",
    "stage_id",
    "role_provenance",
    "representation",
    "scenes"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "scene-space-plan"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "stage_id": {
      "type": "string",
      "const": "spatial_blocking"
    },
    "role_provenance": {
      "type": "string",
      "const": "spatial"
    },
    "representation": {
      "type": "string",
      "enum": [
        "2d-blocking",
        "2.5d-structured-previsualization",
        "verified-3d"
      ]
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "coordinate_system",
          "zones",
          "entrances",
          "fixed_elements",
          "prop_placements",
          "factions",
          "character_placements",
          "movement_paths",
          "interaction_distances",
          "camera_axis",
          "segment_states",
          "continuity_constraints"
        ],
        "properties": {
          "scene_id": {
            "type": "string",
            "minLength": 1
          },
          "coordinate_system": {
            "type": "object",
            "required": [
              "origin",
              "units",
              "axes",
              "bounds"
            ],
            "properties": {
              "origin": {
                "type": "string",
                "minLength": 1
              },
              "units": {
                "type": "string",
                "enum": [
                  "normalized",
                  "meters",
                  "qualitative"
                ]
              },
              "axes": {
                "type": "object",
                "required": [
                  "x",
                  "y",
                  "z"
                ]
              },
              "bounds": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "y": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "z": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ]
              },
              "world_bounds": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "y": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "z": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ]
              }
            },
            "additionalProperties": true,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "units": {
                      "const": "normalized"
                    }
                  }
                },
                "then": {
                  "required": [
                    "world_bounds"
                  ]
                }
              }
            ]
          },
          "zones": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "entrances": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "fixed_elements": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "prop_placements": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "factions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "character_placements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "character_id",
                "position",
                "facing",
                "gaze",
                "faction_id"
              ],
              "properties": {
                "character_id": {
                  "type": "string",
                  "minLength": 1
                },
                "position": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "z"
                  ]
                },
                "facing": {
                  "type": "string",
                  "minLength": 1
                },
                "gaze": {
                  "type": "string",
                  "minLength": 1
                },
                "faction_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "movement_paths": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "interaction_distances": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "camera_axis": {
            "type": "object",
            "required": [
              "line",
              "allowed_side"
            ]
          },
          "segment_states": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "segment_id",
                "start_state",
                "end_state"
              ],
              "properties": {
                "segment_id": {
                  "type": "string",
                  "minLength": 1
                },
                "start_state": {
                  "type": "object"
                },
                "end_state": {
                  "type": "object"
                }
              },
              "additionalProperties": true
            }
          },
          "continuity_constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-comic-drama:3.0:scene-space-plan.schema.json"
}
