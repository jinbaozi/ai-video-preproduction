{
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "project_id",
    "revision",
    "stage_id",
    "role_provenance",
    "shot_id",
    "index",
    "segment_id",
    "scene_id",
    "duration_s",
    "narrative_purpose",
    "character_tracks",
    "camera_track",
    "audio_track",
    "director_track",
    "spatial_track",
    "scene_fixed_track",
    "environment",
    "lighting",
    "continuity",
    "required_asset_ids",
    "selected_reference_ids",
    "negative_constraints",
    "timing"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "artifact_type": {
      "type": "string",
      "const": "shot-timeline-spec"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "stage_id": {
      "type": "string",
      "const": "shot_timeline_specs"
    },
    "role_provenance": {
      "type": "string",
      "const": "storyboard"
    },
    "shot_id": {
      "type": "string",
      "minLength": 1
    },
    "index": {
      "type": "integer",
      "minimum": 1
    },
    "segment_id": {
      "type": "string",
      "minLength": 1
    },
    "scene_id": {
      "type": "string",
      "minLength": 1
    },
    "duration_s": {
      "type": "number",
      "minimum": 1,
      "maximum": 12
    },
    "narrative_purpose": {
      "type": "string",
      "minLength": 1
    },
    "character_tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "character_id",
          "visible_interval",
          "trajectory",
          "action_events",
          "emotion_events"
        ],
        "properties": {
          "character_id": {
            "type": "string",
            "minLength": 1
          },
          "visible_interval": {
            "type": "object",
            "required": [
              "start_s",
              "end_s"
            ],
            "properties": {
              "start_s": {
                "type": "number",
                "minimum": 0
              },
              "end_s": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "trajectory": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "time_s",
                "position",
                "facing",
                "gaze",
                "pose",
                "rotation_quaternion",
                "interpolation"
              ],
              "properties": {
                "time_s": {
                  "type": "number",
                  "minimum": 0
                },
                "position": {
                  "type": "object",
                  "required": [
                    "x",
                    "y",
                    "z"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    }
                  }
                },
                "facing": {
                  "type": "string"
                },
                "gaze": {
                  "type": "string"
                },
                "pose": {
                  "type": "string"
                },
                "rotation_quaternion": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "interpolation": {
                  "enum": [
                    "linear",
                    "hold",
                    "smoothstep"
                  ]
                },
                "joint_targets": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "z": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "z"
                    ]
                  }
                },
                "gaze_target_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "action_events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "event_id",
                "start_s",
                "end_s",
                "channel",
                "phase",
                "description"
              ],
              "properties": {
                "event_id": {
                  "type": "string"
                },
                "start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "end_s": {
                  "type": "number",
                  "minimum": 0
                },
                "channel": {
                  "type": "string"
                },
                "phase": {
                  "type": "string",
                  "enum": [
                    "preparation",
                    "start",
                    "development",
                    "key",
                    "end",
                    "recovery"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "interaction_target": {
                  "type": "string"
                },
                "prop_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "emotion_events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "start_s",
                "end_s",
                "emotion",
                "intensity",
                "visible_cues",
                "trigger"
              ],
              "properties": {
                "start_s": {
                  "type": "number",
                  "minimum": 0
                },
                "end_s": {
                  "type": "number",
                  "minimum": 0
                },
                "emotion": {
                  "type": "string"
                },
                "intensity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "visible_cues": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "trigger": {
                  "type": "string"
                }
              }
            }
          }
        },
        "additionalProperties": true
      }
    },
    "camera_track": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "position": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ]
          },
          "target": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "z": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ]
          },
          "projection": {
            "enum": [
              "perspective",
              "orthographic"
            ]
          },
          "focal_length_mm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "sensor_width_mm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ortho_scale_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "focus_distance_m": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "interpolation": {
            "enum": [
              "linear",
              "hold",
              "smoothstep"
            ]
          },
          "time_s": {
            "type": "number",
            "minimum": 0
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "minimum": 0
          },
          "full_shot": {
            "const": true
          },
          "time_mode": {
            "const": "full_shot"
          }
        },
        "required": [
          "position",
          "target",
          "projection",
          "focal_length_mm",
          "sensor_width_mm",
          "interpolation"
        ],
        "anyOf": [
          {
            "required": [
              "time_s"
            ]
          },
          {
            "required": [
              "start_s",
              "end_s"
            ]
          },
          {
            "required": [
              "full_shot"
            ]
          },
          {
            "required": [
              "time_mode"
            ]
          }
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "projection": {
                  "const": "orthographic"
                }
              }
            },
            "then": {
              "required": [
                "ortho_scale_m"
              ]
            }
          }
        ]
      },
      "minItems": 1
    },
    "audio_track": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "director_track": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "spatial_track": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "scene_fixed_track": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "environment": {
      "type": "object"
    },
    "lighting": {
      "type": "object"
    },
    "continuity": {
      "type": "object",
      "required": [
        "start_state",
        "end_state"
      ],
      "properties": {
        "start_state": {
          "type": "object"
        },
        "end_state": {
          "type": "object"
        }
      }
    },
    "required_asset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selected_reference_ids": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string"
      }
    },
    "negative_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timing": {
      "type": "object",
      "properties": {
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "frame_count": {
          "type": "integer",
          "minimum": 1
        },
        "authority": {
          "const": "frames"
        }
      },
      "required": [
        "fps",
        "frame_count",
        "authority"
      ]
    },
    "prop_tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "trajectory": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "time_s": {
                  "type": "number",
                  "minimum": 0
                },
                "position": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "z"
                  ]
                },
                "holder_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "holder_joint": {
                  "type": "string",
                  "minLength": 1
                },
                "handoff_from": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "state": {
                  "type": "string",
                  "minLength": 1
                },
                "interpolation": {
                  "enum": [
                    "linear",
                    "hold",
                    "smoothstep"
                  ]
                }
              },
              "required": [
                "time_s",
                "position",
                "holder_id",
                "interpolation"
              ]
            },
            "minItems": 1
          }
        },
        "required": [
          "asset_id",
          "trajectory"
        ]
      }
    }
  },
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-comic-drama:3.0:shot-timeline-spec.schema.json"
}
